# انسخ هذا الملف إلى .env واكتب فيه مفاتيحك. لا يُرفع .env إلى المستودع.

# مفتاح OpenRouter (اختياري): الطريق الأساسي للتصنيف بالنموذج google/gemini-3.8-flash.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# مفتاح Gemini API: الطريق الاحتياطي إن لم يوجد مفتاح OpenRouter أو تعذّر.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
